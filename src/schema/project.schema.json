{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automatic-video-editor.local/project.schema.json",
  "title": "Automatic Video Editor Project",
  "type": "object",
  "required": ["project", "assets", "timeline"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "exportPreset": {
      "type": "string",
      "enum": ["youtube_1080p", "tiktok_reels", "shorts", "square", "discord_720p", "cinematic_4k", "instagram_reels", "high_quality_archive", "low_size_preview"]
    },
    "stylePreset": {
      "type": "string",
      "enum": ["clean_cinematic", "gaming_montage", "red_black_aegis", "blue_black_cyber", "vaporwave", "minimal_tech", "horror_glitch", "luxury_promo"]
    },
    "brandKit": {
      "type": "object",
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["width", "height", "fps", "duration"],
      "additionalProperties": true,
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "string" },
        "exportPreset": {
          "type": "string",
          "enum": ["youtube_1080p", "tiktok_reels", "shorts", "square", "discord_720p", "cinematic_4k", "instagram_reels", "high_quality_archive", "low_size_preview"]
        },
        "crf": { "type": "integer", "minimum": 0, "maximum": 51 }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "audio": {
      "type": "array",
      "items": { "$ref": "#/$defs/audioTrack" },
      "default": []
    },
    "captions": {
      "type": "array",
      "items": { "$ref": "#/$defs/caption" },
      "default": []
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "start", "duration", "layers"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/layer" },
          "default": []
        },
        "transitionOut": { "$ref": "#/$defs/transition" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "video",
            "image",
            "text",
            "caption",
            "captions",
            "solid",
            "broll",
            "b-roll",
            "shape",
            "progress",
            "lower_third",
            "hud",
            "animated_background",
            "particle",
            "waveform"
          ]
        },
        "asset": { "type": "string" },
        "text": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/caption" }
        },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "trimStart": { "type": "number", "minimum": 0 },
        "trimEnd": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "crop": { "$ref": "#/$defs/crop" },
        "blur": { "type": "number", "minimum": 0 },
        "brightness": { "type": "number" },
        "contrast": { "type": "number", "exclusiveMinimum": 0 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontFamily": { "type": "string" },
        "color": { "type": "string" },
        "strokeColor": { "type": "string" },
        "strokeWidth": { "type": "number", "minimum": 0 },
        "shadowColor": { "type": "string" },
        "shadowX": { "type": "number" },
        "shadowY": { "type": "number" },
        "box": { "type": "boolean" },
        "boxColor": { "type": "string" },
        "boxPadding": { "type": "number", "minimum": 0 },
        "animation": { "$ref": "#/$defs/animation" },
        "effects": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["video", "image"] } },
            "required": ["type"]
          },
          "then": { "required": ["asset"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "text" } },
            "required": ["type"]
          },
          "then": { "required": ["text"] }
        }
      ]
    },
    "audioTrack": {
      "type": "object",
      "required": ["asset"],
      "additionalProperties": true,
      "properties": {
        "asset": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "trimStart": { "type": "number", "minimum": 0 },
        "trimEnd": { "type": "number", "minimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "fadeIn": { "type": "number", "minimum": 0 },
        "fadeOut": { "type": "number", "minimum": 0 },
        "loop": { "type": "boolean" }
      }
    },
    "caption": {
      "type": "object",
      "required": ["text", "start"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "x": { "$ref": "#/$defs/position" },
        "y": { "$ref": "#/$defs/position" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cut", "crossfade", "fade", "fadeToBlack", "slide", "zoom"]
        },
        "duration": { "type": "number", "minimum": 0 },
        "direction": {
          "type": "string",
          "enum": ["left", "right", "up", "down"]
        }
      }
    },
    "animation": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "fade",
            "slideUp",
            "slideDown",
            "slideLeft",
            "slideRight",
            "zoomIn",
            "zoomOut",
            "shake",
            "pulse",
            "typewriter"
          ]
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "in": {
              "type": "string",
              "enum": [
                "fade",
                "slideUp",
                "slideDown",
                "slideLeft",
                "slideRight",
                "zoomIn",
                "zoomOut",
                "shake",
                "pulse",
                "typewriter"
              ]
            },
            "out": {
              "type": "string",
              "enum": [
                "fade",
                "slideUp",
                "slideDown",
                "slideLeft",
                "slideRight",
                "zoomIn",
                "zoomOut",
                "shake",
                "pulse"
              ]
            },
            "duration": { "type": "number", "minimum": 0 },
            "inDuration": { "type": "number", "minimum": 0 },
            "outDuration": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "crop": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "default": 0 },
        "y": { "type": "number", "default": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "position": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "pattern": "^(center|middle|left|right|top|bottom|[-+]?[0-9]+(\\.[0-9]+)?%?)$"
        }
      ]
    }
  }
}
